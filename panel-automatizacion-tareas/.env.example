# ─── Base de datos ───────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/task_automation_panel?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# ─── JPA ─────────────────────────────────────────────────────────────────────
JPA_DDL_AUTO=update

# ─── Servidor ────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── JWT (CAMBIAR EN PRODUCCIÓN — mínimo 32 caracteres) ─────────────────────
JWT_SECRET=change-this-to-a-256-bit-secret-key-for-production-use-min-32-chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Seed admin inicial ──────────────────────────────────────────────────────
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=Admin123!

# ─── Frontend (.env en /frontend) ────────────────────────────────────────────
# VITE_API_URL=/api/v1
